{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": "../../../ui/apps/v4",
    "paths": {
      "@/app/(create)/*": ["./app/(app)/(create)/*"],
      "@/app/(app)/create/*": ["./app/(app)/(create)/*"],
      "@/*": ["./*"]
    }
  }
}
