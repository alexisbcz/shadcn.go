E\">  const</span><span style=\"--shiki-dark:#FFF;--shiki-light:#1F2328\"> [</span><span style=\"--shiki-dark:#FFF;--shiki-light:#0550AE\">open</span><span style=\"--shiki-dark:#FFF;--shiki-light:#1F2328\">, </span><span style=\"--shiki-dark:#FFF;--shiki-light:#0550AE\">setOpen</span><span style=\"--shiki-dark:#FFF;--shiki-light:#1F2328\">] </span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#CF222E\">=</span><span style=\"--shiki-dark:#FFF;--shiki-light:#1F2328\"> React.</span><span style=\"--shiki-dark:#FFC799;--shiki-light:#8250DF\">useState</span><span style=\"--shiki-dark:#FFF;--shiki-light:#1F2328\">(</span><span style=\"--shiki-dark:#FFC799;--shiki-light:#0550AE\">false</span><span style=\"--shiki-dark:#FFF;--shiki-light:#1F2328\">)</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#CF222E\">  return</span><span style=\"--shiki-dark:#FFF;--shiki-light:#1F2328\"> (</span></span>\n<span data-line=\"\"><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#1F2328\">    &#x3C;</span><span style=\"--shiki-dark:#FFC799;--shiki-light:#116329\">Collapsible</span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#0550AE\"> open</span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#CF222E\">={</span><span style=\"--shiki-dark:#FFF;--shiki-light:#1F2328\">open</span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#CF222E\">}</span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#0550AE\"> onOpenChange</span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#CF222E\">={</span><span style=\"--shiki-dark:#FFF;--shiki-light:#1F2328\">setOpen</span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#CF222E\">}</span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#1F2328\">></span></span>\n<span data-line=\"\"><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#1F2328\">      &#x3C;</span><span style=\"--shiki-dark:#FFC799;--shiki-light:#116329\">CollapsibleTrigger</span><span style=\"--shiki-dark:#A0A0A0;--shik