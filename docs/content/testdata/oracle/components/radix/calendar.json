E\">=</span><span style=\"--shiki-dark:#99FFE4;--shiki-light:#0A3069\">\"single\"</span></span>\n<span data-line=\"\"><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#0550AE\">  selected</span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#CF222E\">={</span><span style=\"--shiki-dark:#FFF;--shiki-light:#1F2328\">date</span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#CF222E\">}</span></span>\n<span data-line=\"\"><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#0550AE\">  onSelect</span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#CF222E\">={</span><span style=\"--shiki-dark:#FFF;--shiki-light:#1F2328\">setDate</span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#CF222E\">}</span></span>\n<span data-line=\"\"><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#0550AE\">  className</span><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#CF222E\">=</span><span style=\"--shiki-dark:#99FFE4;--shiki-light:#0A3069\">\"rounded-lg border [--cell-size:2.75rem] md:[--cell-size:3rem]\"</span></span>\n<span data-line=\"\"><span style=\"--shiki-dark:#A0A0A0;--shiki-light:#1F2328\">/></span></span></code></pre></figure>\n<h2 id=\"week-numbers\">Week Numbers</h2>\n<p>Use <code>showWeekNumber</code> to show week numbers.</p>\n<mdx-jsx data-name=\"ComponentPreview\" data-flow=\"true\" data-attrs=\"[{&#x22;name&#x22;:&#x22;styleName&#x22;,&#x22;value&#x22;:&#x22;radix-nova&#x22;},{&#x22;name&#x22;:&#x22;name&#x22;,&#x22;value&#x22;:&#x22;calendar-week-numbers&#x22;},{&#x22;name&#x22;:&#x22;previewClassName&#x22;,&#x22;value&#x22;:&#x22;h-96&#x22;}]\"></mdx-jsx>\n<h2 id=\"rtl\">RTL</h2>\n<p>To enable RTL support in shadcn/ui, see the <a href=\"/docs/rtl\">RTL configuration guide</a>.</p>\n<p>See also the <a href=\"#persian--hijri--jalali-calendar\">Hijri Guide</a> for enabling the Persian / Hijri / Jalali calendar.</p>\n<mdx-jsx data-name=\"ComponentPreview\" data-flow=\"true\" data-attrs=\"[{&#x22;name&#x22;:&#x22;styleName&#x22;,&#x22;value&#x22;:&#x22;radix-nova&#x2