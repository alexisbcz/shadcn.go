 {
  "label": "drag-select",
  "reset": true,
  "steps": [
   {
    "do": "hover",
    "target": "[data-slot=select-trigger]"
   },
   {
    "do": "down"
   },
   {
    "do": "mouse",
    "x": 512,
    "y": 470,
    "steps": 5
   },
   {
    "do": "up"
   }
  ]
 },
 {
  "label": "v-right-click-no-open",
