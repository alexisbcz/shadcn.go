  "frames": false,
  "steps": [
   {
    "do": "hover",
    "target": "[data-slot=select-trigger]"
   },
   {
    "do": "down",
    "button": "right"
   },
   {
    "do": "up",
    "button": "right"
   },
   {
    "do": "wait",
    "ms": 50
   }
  ]
 },
 {
  "label": "v-keyboard-open-arrowup",
