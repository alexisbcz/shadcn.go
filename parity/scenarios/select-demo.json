    "key": "ArrowUp"
   }
  ]
 },
 {
  "label": "v-resize-closes",
  "steps": [
   {
    "do": "eval",
    "js": "window.dispatchEvent(new Event('resize'))"
   }
  ]
 },
 {
  "label": "v-reopen-for-blur",
  "steps": [
