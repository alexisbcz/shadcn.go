    "do": "click",
    "target": "[data-slot=select-trigger]"
   }
  ]
 },
 {
  "label": "v-window-blur-closes",
  "steps": [
   {
    "do": "eval",
    "js": "window.dispatchEvent(new Event('blur'))"
   }
  ]
 },
 {
  "label": "v-modifier-no-typeahead",
