    "js": "(() => { const t = document.querySelector(\"[data-slot=tooltip-trigger]\"); const r = t.getBoundingClientRect(); const o = { bubbles: true, cancelable: true, composed: true, clientX: r.x + 5, clientY: r.y + 5, pointerType: \"touch\", isPrimary: true, pointerId: 2 }; t.dispatchEvent(new PointerEvent(\"pointerover\", o)); })()"
   },
