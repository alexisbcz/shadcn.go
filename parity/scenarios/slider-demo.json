 {
  "label": "click-track-center",
  "steps": [
   {
    "do": "click",
    "target": "[data-slot=slider-track]"
   }
  ]
 },
 {
  "label": "drag-thumb-left",
  "steps": [
   {
    "do": "drag",
    "target": "[role=slider]",
    "dx": -120,
    "steps": 6
   }
  ]
 },
 {
  "label": "drag-track-right",
  "steps": [
   {
    "do": "drag",
    "target": "[data-slot=slider-track]",
    "dx": 90,
    "steps": 5
   }
  ]
 },
 {
  "label": "drag-past-end",
  "steps": [
   {
    "do": "drag",
    "target": "[role=slider]",
    "dx": 900,
    "steps": 4
   }
  ]
 },
 {
  "label": "blur-hover-thumb",
  "steps": [
   {
    "do": "mouse",
    "x": 1000,
    "y": 700
   },
   {
    "do": "eval",
    "js": "document.activeElement.blur()"
   },
   {
    "do": "hover",
    "target": "[role=slider]"
   }
  ]
 },
 {
  "label": "mouse-away",
  "steps": [
   {
    "do": "mouse",
    "x": 1000,
    "y": 700
   }
  ]
 }
]