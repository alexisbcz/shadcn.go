[
  {
    "label": "open-top",
    "reset": true,
    "steps": [
      {
        "do": "click",
        "target": "[data-slot=drawer-trigger]",
        "nth": 0
      }
    ]
  },
  {
    "label": "top-settle",
    "frames": false,
    "steps": [
      {
        "do": "wait",
        "ms": 600
      }
    ]
  },
  {
    "label": "top-drag-close",
    "steps": [
      {
        "do": "drag",
        "target": "[data-slot=drawer-title]",
        "dx": 0,
        "dy": -200
      }
    ]
  },
