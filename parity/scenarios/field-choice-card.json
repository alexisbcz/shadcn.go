   },
   {
    "do": "wait",
    "ms": 50
   },
   {
    "do": "eval",
    "js": "document.activeElement.dispatchEvent(new KeyboardEvent(\"keyup\", { key: \"ArrowDown\", code: \"ArrowDown\", bubbles: true, cancelable: true }))"
   }
  ]
 },
