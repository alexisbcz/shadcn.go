[
 {
  "label": "click-vm-card",
  "steps": [
   {
    "do": "click",
    "target": "[data-slot=field-label]",
    "nth": 2
   }
  ]
 },
 {
  "label": "arrow-up",
  "steps": [
   {
    "do": "press",
    "key": "Shift"
   },
   {
    "do": "eval",
    "js": "document.activeElement.dispatchEvent(new KeyboardEvent(\"keydown\", { key: \"ArrowUp\", code: \"ArrowUp\", bubbles: true, cancelable: true }))"
   },
   {
    "do": "wait",
    "ms": 50
   },
   {
    "do": "eval",
    "js": "document.activeElement.dispatchEvent(new KeyboardEvent(\"keyup\", { key: \"ArrowUp\", code: \"ArrowUp\", bubbles: true, cancelable: true }))"
   }
  ]
 },
 {
  "label": "arrow-down",
