 {
  "label": "dismiss-outside",
  "steps": [
   {
    "do": "eval",
    "js": "(() => { const el = document.elementFromPoint(5, 5); const o = { bubbles: true, cancelable: true, composed: true, clientX: 5, clientY: 5, button: 0, buttons: 1, pointerType: 'mouse', isPrimary: true, pointerId: 1 }; el.dispatchEvent(new PointerEvent('pointerdown', o)); el.dispatchEvent(new MouseEvent('mousedown', o)); el.dispatchEvent(new PointerEvent('pointerup', o)); el.dispatchEvent(new MouseEvent('mouseup', o)); el.dispatchEvent(new MouseEvent('click', o)); })()"
   },
   {
    "do": "eval",
    "js": "getSelection().removeAllRanges()"
   }
  ]
 },
 {
  "label": "dismiss-idle",
  "frames": false,
  "steps": [
   {
    "do": "wait",
    "ms": 500
   }
  ]
 },
 {
  "label": "w-touch-ignored",
  "reset": true,
  "steps": [
   {
    "do": "eval",
    "js": "new Promise((r) => { const i = new Image(); i.onload = i.onerror = () => r(); i.src = \"https://github.com/vercel.png\" })"
   },
   {
    "do": "eval",
    "js": "document.activeElement && document.activeElement.blur()"
   },
   {
    "do": "eval",
    "js": "(() => { const t = document.querySelector(\"[data-slot=hover-card-trigger]\"); const r = t.getBoundingClientRect(); const o = { bubbles: true, cancelable: true, composed: true, clientX: r.x + 5, clientY: r.y + 5, pointerType: \"touch\", isPrimary: true, pointerId: 2 }; t.dispatchEvent(new PointerEvent(\"pointerover\", o)); })()"
   },
   {
    "do": "eval",
    "js": "(() => { const t = document.querySelector(\"[data-slot=hover-card-trigger]\"); const r = t.getBoundingClientRect(); const o = { bubbles: false, cancelable: true, composed: true, clientX: r.x + 5, clientY: r.y + 5, pointerType: \"touch\", isPrimary: true, pointerId: 2 }; t.dispatchEvent(new PointerEvent(\"pointerenter\", o)); })()"
   },
   {
    "do": "wait",
    "ms": 1000
   }
  ]
 },
